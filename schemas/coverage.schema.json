{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-audit.local/schemas/v1/coverage",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inventoried": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "assessed": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "additionalProperties": false
            }
          },
          "deferred_reason": {
            "type": "string"
          }
        },
        "required": [
          "scope_id",
          "assessed"
        ],
        "additionalProperties": false
      }
    },
    "observed_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "repo_id",
    "snapshot",
    "inventoried",
    "assessed",
    "observed_reads",
    "deferred",
    "limitations"
  ],
  "additionalProperties": false
}
