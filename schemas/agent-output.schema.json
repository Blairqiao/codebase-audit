{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-audit.local/schemas/v1/agent-output",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "finding",
              "investigation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "correctness",
              "security",
              "concurrency",
              "maintenance",
              "architecture",
              "style",
              "testing"
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "primary_location": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "symbol": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "line"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "line",
                "snippet"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "next_action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "problem_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "related_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "line"
              ],
              "additionalProperties": false
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger_conditions": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "verification_level": {
            "enum": [
              "reported",
              "supported",
              "reproduced"
            ]
          }
        },
        "required": [
          "kind",
          "title",
          "category",
          "rule_id",
          "primary_location",
          "evidence",
          "mechanism",
          "impact",
          "next_action",
          "severity",
          "confidence",
          "problem_key"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "finding"
                }
              }
            },
            "then": {
              "required": [
                "trigger_conditions"
              ],
              "properties": {
                "trigger_conditions": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    },
    "scope_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "assessed": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "additionalProperties": false
            }
          },
          "deferred_reason": {
            "type": "string"
          }
        },
        "required": [
          "scope_id",
          "assessed"
        ],
        "additionalProperties": false
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "sandbox": {
          "type": "string"
        },
        "observed_model": {
          "type": "string"
        },
        "capability_status": {
          "enum": [
            "verified",
            "unsupported"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens": {
          "type": "number",
          "minimum": 0
        },
        "total_tokens": {
          "type": "number",
          "minimum": 0
        },
        "launches": {
          "type": "number",
          "minimum": 0
        },
        "measurement_limits": {
          "type": "string"
        },
        "unknown": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "repo_id",
    "snapshot",
    "candidates",
    "scope_ledger"
  ],
  "additionalProperties": false
}
