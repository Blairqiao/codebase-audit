{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-audit.local/schemas/v1/evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "version": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "started_at": {
                "type": "string"
              },
              "finished_at": {
                "type": "string"
              },
              "raw_artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "size_bytes": {
                      "type": "number",
                      "minimum": 0
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "kind": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "status": {
            "type": "string"
          },
          "parser_status": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pass_exit_codes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "finding_exit_codes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "raw_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": "number",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "column": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "end_line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "end_column": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "rule_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "category",
          "command",
          "status",
          "parser_status",
          "diagnostics"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repo_id",
    "snapshot",
    "checks"
  ],
  "additionalProperties": false
}
