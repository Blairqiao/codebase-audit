{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-audit.local/schemas/v1/policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "correctness",
              "security",
              "concurrency",
              "maintenance",
              "architecture",
              "style",
              "testing"
            ]
          },
          "applicability": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "retrieved": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "license_url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "section",
              "retrieved",
              "attribution",
              "license",
              "license_url"
            ],
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "revision"
                ]
              },
              {
                "required": [
                  "sha256"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "category",
          "applicability",
          "instructions",
          "required_evidence",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "rules"
  ],
  "additionalProperties": false
}
